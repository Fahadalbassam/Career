# =============================================================================
# Career Finder AI – Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
#
# ⚠️  WARNING: Never commit the real .env file to GitHub.
#              The .env file is listed in .gitignore for your protection.
# =============================================================================

APP_ENV=development
DATABASE_URL=sqlite:///./database/career_finder.db

# ---------------------------------------------------------------------------
# Optional – AWS Bedrock (leave blank for local-only mode)
# Only needed if you later integrate an LLM for parsing or explanations.
# ---------------------------------------------------------------------------
AWS_REGION=
BEDROCK_MODEL_ID=
AWS_BEARER_TOKEN_BEDROCK=
