# =============================================================================
# Career Finder AI – Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
#
# WARNING: Never commit the real .env file to GitHub.
#          The .env file is listed in .gitignore.
# =============================================================================

APP_ENV=development
DATABASE_URL=sqlite:///./database/career_finder.db

# Optional: enable ML shadow scores on /recommend (live ranking stays rubric-based)
# CAREERFINDER_ENABLE_ML_SCORE=false
