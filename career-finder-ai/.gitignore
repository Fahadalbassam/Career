# =============================================================================
# Career Finder AI – .gitignore
# =============================================================================

# Local agent instructions (not shared in repo)
AGENTS.md

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyc

# Environment variables (NEVER commit these)
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3

# Trained model artefacts
models/*.joblib
models/*.pkl

# Jupyter
.ipynb_checkpoints/

# Node / Next.js
node_modules/
.next/
dist/
.npm/
build/

# macOS / Windows
.DS_Store
Thumbs.db

# VS Code local config (keep extensions.json)
.vscode/settings.json
.vscode/.ropeproject/
.cursor/

# Build artefacts
*.egg-info/

# Test and coverage artefacts
.pytest_cache/
backend/.pytest_cache/
backend/pytest-cache-files-*/
.coverage
htmlcov/
coverage/
.mypy_cache/
.ruff_cache/
.cache/
playwright-report/
test-results/

# Logs and temp files
*.log
*.tmp
*.bak
cli_out*.txt
backend/cli_out*.txt

# Internal planning / scratch (not for submission)
docs/tracking/
docs/scratch/
docs/prompts/
docs/context/
docs/planning/
docs/audits/
Pasted*.md
Pasted*.txt
*_draft.*
*_backup.*
*_old.*

# Manual CLI capture logs (local smoke tests)
# Archived legacy generated outputs (see data/archive/README.md)
data/archive/
